{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.17.0/schemas/schema.json",
  "services": [
    {
      "product": "Authentication",
      "component": "auth-smoke-tests",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/pre-commit.yml",
          "path": "$.jobs.pre-commit"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/dependency-review.yml",
          "path": "$.jobs.dependency-review"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.run-tests"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.run-sonar-code-analysis"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/checkov.yml",
          "path": "$.jobs.scan"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/dependabot-validate.yml",
          "path": "$.jobs.validate"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/require-pinned-github-actions.yml",
          "path": "$.jobs.check-actions-sha"
        }
      ]
    }
  ]
}
